---
import Layout from '../layouts/Layout.astro';
import About from '../components/About.astro';
import Work from '../components/Portfolio.astro';
import Services from '../components/Services.astro';
import Contact from '../components/Contact.astro';
---

<Layout title="Be Mako | Technical SEO & Data Automation" description='give your business a permanent competitive advantage'>
    <div class="home-container">
        
        <section class="hero hero-waves-bg">
               
            <div class="page-content hero-content">
                <h1 class="title">Anna <span class="text-gradient">Chumakova</span><br>
                <span class="tagline block text-gradient">SEO SERVICES <span class="white">&</span> <span class="tagline block text-gradient">AI Promotion</span>
                </h1>
        
                <p class="hero-slogan">
                    The Mako is the fastest shark in the ocean. And I’m telling you: Be Mako.
                </p>
                <p class="hero-description">
                While you are second-guessing whether your website even needs SEO, your competitors are already stealing your clients. 
                In modern search, victory belongs to those who act with precision, aggression, and superior tech. 
                </p>

                <a href="#contact" class="mako-btn code-accent">
                <span>GET IN TOUCH</span>
                <span class="btn-glow"></span>
                </a>
            </div>
        </section>
        <section class="page-content"><About /></section>
        <section class="page-content"><Work /></section>
        <section class="page-content"><Services /></section>
        <section class="page-content"><Contact /></section>

    </div> 
</Layout>

<style>

    .home-container {
        width: 100%;
        position: relative;
        margin: 0;
        padding: 0;

    }
    
    .hero {

        text-align: center;
        padding: 4rem 0 4rem;
        min-height: 100vh; 
        
    }
    @media (max-width: 768px) {
    .hero {
        
        min-height: auto;
    }
    }

    .hero-waves-bg {
        
        width: 100%;
        height: auto;
        
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 1440 680' preserveAspectRatio='none' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cdefs%3E%3Cfilter id='neon-glow' x='-30%25' y='-30%25' width='160%25' height='160%25'%3E%3CfeGaussianBlur stdDeviation='6' result='blur1'/%3E%3CfeGaussianBlur stdDeviation='15' result='blur2'/%3E%3CfeMerge%3E%3CfeMergeNode in='blur2'/%3E%3CfeMergeNode in='blur1'/%3E%3CfeMergeNode in='SourceGraphic'/%3E%3C/feMerge%3E%3C/filter%3E%3Cfilter id='ultra-soft-glow' x='-50%25' y='-70%25' width='200%25' height='240%25'%3E%3CfeGaussianBlur stdDeviation='8' result='core-blur'/%3E%3CfeGaussianBlur stdDeviation='25' result='mid-blur'/%3E%3CfeGaussianBlur stdDeviation='55' result='wide-glow'/%3E%3CfeMerge%3E%3CfeMergeNode in='wide-glow'/%3E%3CfeMergeNode in='mid-blur'/%3E%3CfeMergeNode in='core-blur'/%3E%3C/feMerge%3E%3C/filter%3E%3C/defs%3E%3C!-- Точки мазка смещены ниже по оси Y (со 80px до 150px), чтобы размытие не обрезалось сверху --%3E%3Cpath d='M 0 153 C 300 35, 500 140, 800 375 C 1100 605, 1250 465, 1440 471 L 1440 469 C 1250 455, 1100 595, 800 365 C 500 155, 300 25, 0 147 Z' fill='%2300f3ff' opacity='0.85' filter='url(%23ultra-soft-glow)'/%3E%3Cpath d='M 0 390 C 250 250, 500 430, 750 530 C 1000 630, 1200 370, 1440 390' stroke='%2300d8f0' stroke-width='2.0' opacity='0.8' filter='url(%23neon-glow)'/%3E%3Cpath d='M 0 260 C 400 430, 650 190, 900 440 C 1150 690, 1300 530, 1440 540' stroke='%2300b5bc' stroke-width='1.2' opacity='0.5'/%3E%3Cpath d='M 0 500 C 300 370, 550 570, 800 470 C 1050 370, 1250 560, 1440 580' stroke='%23007a80' stroke-width='1.5' opacity='0.3'/%3E%3Cpath d='M 0 210 C 250 70, 600 530, 950 310 C 1200 140, 1350 490, 1440 440' stroke='%2300e1eb' stroke-width='0.8' opacity='0.4'/%3E%3C/svg%3E");
        background-repeat: no-repeat;
        background-position: bottom center;
        background-size: 100% 55vh;
  
    }
    
    .title {
        
        font-size: clamp(1.5rem, 2.5vw + 0.5rem, 1.8rem);
        margin: 0 0 1rem;
        color: #fff;
        font-weight: 800;
    }
    .text-gradient {
        color: var(--mako-cyan);
        text-shadow: 0 0 30px rgba(0, 240, 255, 0.3);
    }
    .tagline {
        font-family: monospace;
        letter-spacing: 2px;
        font-size: clamp(2rem, 5.5vw + 0.5rem, 3.5rem);
        
        line-height: 1.5;
        margin: 0;
        color: var(--mako-cyan);
        text-shadow: 0 0 30px rgba(0, 240, 255, 0.3);
    }
    @media (max-width: 768px) {
   
    .tagline {
       
        font-size: clamp(1.3rem, 4.5vw, 2.5rem); 
        white-space: nowrap; /* Запрещаем перенос слов на новую строку */
        letter-spacing: 1px; /* Чуть сужаем межбуквенный интервал на мобилке */
        
    }
    .title {
        font-size: clamp(0.85rem, 4vw, 2rem); 
    }
    .hero-waves-bg {
        background-size: 100% 28vh;
    }

    }
    .white {
    color: white;
    }
    
    .hero-slogan {
        font-size: clamp(1.1rem, 1.5vw + 0.5rem, 1.3rem);
        color: #fff;
        margin-top: 2rem;
        margin-bottom: 1rem;
        font-weight: 500;
        line-height: 1.6;
    }

    /* Основное описание: приглушаем до благородного серого тона */
    .hero-description {
        font-size: clamp(0.95rem, 1vw + 0.5rem, 1.05rem);
        color: #a0aec0; /* Мягкий матовый оттенок убирает визуальный шум */
        line-height: 1.7;
        margin-bottom: 1.5rem;
        max-width: 720px;
    }

    /* Контейнер для выравнивания */
    .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 900px; /* Чтобы текст не растягивался во всю ширину экрана и легко читался */
    margin: 0 auto;
    z-index: 2;
    }

    /* Стилизация кнопки */
    .mako-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 2.5rem;
    margin-top: 2.5rem;
    color: #0B1117; /* Темный текст на неоновом фоне смотрится максимально контрастно и дорого */
    background: #00eeff9e;
    font-size: 0.9rem;
    letter-spacing: 2px;
    text-decoration: none !important;
    text-transform: uppercase;
    font-weight: 700;
    border-radius: 4px;
    border: 1px solid #00F0FF;
    overflow: hidden;
    transition: all 0.3s ease;
    
    /* Базовый неоновый теневой шлейф */
    box-shadow: 0 0 15px rgba(0, 240, 255, 0.35), 
                0 0 30px rgba(0, 240, 255, 0.1);
    }

    /* Текст кнопки приподнимаем над эффектами */
    .mako-btn span:not(.btn-glow) {
    position: relative;
    z-index: 2;
    }

    /* Внутреннее свечение (блик при наведении) */
    .mako-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
        90deg,
        transparent,
        rgba(255, 255, 255, 0.4),
        transparent
    );
    transition: 0.5s;
    z-index: 1;
    }

    /* Эффект при наведении (Hover) */
    .mako-btn:hover {
    color: #fff;
    background: transparent; /* Переключаемся на контурный неон */
    box-shadow: 0 0 20px rgba(0, 240, 255, 0.6), 
                0 0 40px rgba(0, 240, 255, 0.3),
                inset 0 0 15px rgba(0, 240, 255, 0.4);
    text-shadow: 0 0 5px rgba(0, 240, 255, 0.5);
    }

    .mako-btn:hover::before {
    left: 100%;
    }

    /* Активное состояние (клик) */
    .mako-btn:active {
    transform: scale(0.98);
    box-shadow: 0 0 10px rgba(0, 240, 255, 0.5);
    }
</style>