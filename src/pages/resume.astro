---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Resume | Anna Chumakova - Senior SEO Specialist"
  description="Professional resume of Anna Chumakova, Senior SEO Specialist & Digital Marketer. Expertise in Technical SEO, Programmatic SEO, AI/GEO, and Full-Stack Web Development."
>
  <div class="page-content resume-container">
    <!-- Панель действия (скачивание/печать) -->
    <div class="action-bar">
      <span class="code-badge">// CURRICULUM VITAE</span>
      <a
        href="/Anna_Chumakova_Resume_EN.pdf"
        download="Anna_Chumakova_Resume_EN.pdf"
        class="print-btn"
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        DOWNLOAD PDF
      </a>
    </div>

    <!-- Основной сетка-контейнер резюме -->
    <div class="resume-grid">
      <!-- Левая колонка (Sidebar) -->
      <aside class="resume-sidebar">
        <div class="photo-wrapper">
          <img
            class="profile-photo"
            src="/photo_resume2.jpg"
            alt="Anna Chumakova"
          />
        </div>

        <h1 class="resume-name">Anna Chumakova</h1>
        <p class="resume-title">Senior SEO Specialist & Digital Marketer</p>

        <div class="side-block">
          <h3>Contact Info</h3>
          <ul class="contact-list">
            <li><span>Location:</span> Burgas, Bulgaria</li>
            <li>
              <span>Email:</span>
              <a href="mailto:ann020187@gmail.com">ann020187@gmail.com</a>
            </li>
            <li><span>Phone:</span> +359 876 793 877</li>
            <li>
              <span>LinkedIn:</span>
              <a
                href="https://www.linkedin.com/in/anna-chumakova-profil/"
                target="_blank">anna-chumakova-profil</a
              >
            </li>
            <li>
              <span>Telegram:</span>
              <a href="https://t.me/Anna_webmaster_bg" target="_blank"
                >@Anna_webmaster_bg</a
              >
            </li>
            <li>
              <span>GitHub:</span>
              <a href="https://github.com/Anna-Chumakova" target="_blank"
                >Anna-Chumakova</a
              >
            </li>
          </ul>
        </div>

        <div class="side-block">
          <h3>Key Skills</h3>
          <div class="skill-badges">
            <span class="badge">SEO Strategy</span>
            <span class="badge">Programmatic SEO</span>
            <span class="badge">Technical SEO</span>
            <span class="badge">AI SEO / GEO / AEO</span>
            <span class="badge">Semantic Core & Clustering</span>
            <span class="badge">Link Building</span>
            <span class="badge">UX / UI Audit</span>
            <span class="badge">Web Analytics (GA4, GSC)</span>
            <span class="badge">HTML / CSS / JS / Node.js</span>
            <span class="badge">WordPress</span>
            <span class="badge">OpenCart</span>
            <span class="badge">Framer</span>
            <span class="badge">Tilda</span>
            <span class="badge">Astro</span>
          </div>
        </div>

        <div class="side-block">
          <h3>Tools & Tech</h3>
          <ul class="info-list">
            <li>
              <strong>SEO:</strong> Ahrefs, Screaming Frog, SE Ranking, Whatsmyserp
            </li>
            <li><strong>Analytics:</strong> GSC, GA4, Looker Studio, GTM</li>
            <li>
              <strong>Dev:</strong> HTML5, CSS3, JavaScript, React, Node.js, JSON
            </li>
            <li>
              <strong>AI:</strong> Content generation & prompt engineering
            </li>
            <li>
              <strong>Content & CMS:</strong> Hands-on experience with WordPress,
              OpenCart, Tilda, Framer, Astro. Basic HTML/CSS layout editing, content
              updates for custom/static sites
            </li>
          </ul>
        </div>

        <div class="side-block">
          <h3>Languages</h3>
          <ul class="info-list">
            <li><strong>Russian:</strong> Native</li>
            <li><strong>Ukrainian:</strong> Native</li>
            <li><strong>English:</strong> Intermediate / Proficient Written</li>
            <li>
              <strong>Bulgarian:</strong> Intermediate / Proficient Written
            </li>
          </ul>
        </div>
        <div class="side-block">
          <h3>Soft Skills</h3>
          <ul class="info-list">
            <li>Analytical Mindset</li>
            <li>Problem Solving</li>
            <li>Teamwork & Collaboration</li>
            <li>Client Orientation</li>
          </ul>
        </div>
      </aside>

      <!-- Правая колонка (Основной контент) -->
      <main class="resume-main">
        <section class="main-block">
          <h2 class="section-title">// Professional Summary</h2>
          <p class="summary-text">
            Results-driven Senior SEO Specialist with over 3 years of experience
            across Programmatic SEO, technical SEO, content strategy, semantic
            architecture, and web analytics. Proven track record in optimizing
            international platforms, implementing AI-driven Search Engine
            Optimization (GEO/AEO), executing technical audits, and building web
            solutions. Skilled in combining SEO expertise with full-stack web
            development principles to maximize domain authority and organic
            growth.
          </p>
        </section>

        <section class="main-block">
          <h2 class="section-title">// Experience</h2>

          <div class="job-card">
            <div class="job-header">
              <h3>
                SEO Specialist <span class="company">@ Penguin-team</span>
              </h3>
              <span class="job-date">Dec 2025 – Present</span>
            </div>
            <p class="job-sub">Dnipro (Remote) • Marketing & Advertising</p>
            <ul class="job-bullets">
              <li>
                <strong>Strategic Planning & Architecture:</strong> Developed end-to-end
                SEO strategies, semantic keyword clustering, and scalable site architectures
                for international target markets.
              </li>
              <li>
                <strong>AI SEO & Content Optimization:</strong> Implemented modern
                AI-based strategies (AEO / GEO) to maximize brand presence across
                AI search platforms (ChatGPT, Perplexity, Google AI Overviews). Created
                detailed technical specifications for copywriters.
              </li>
              <li>
                <strong>Technical SEO & UX Audits:</strong> Conducted comprehensive
                technical audits (Screaming Frog, GSC, Ahrefs), site speed optimizations,
                and UX/UI audits targeting checkout flow and navigation.
              </li>
              <li>
                <strong>Link Building Management:</strong> Conducted competitor backlink
                profile analysis, donor domain selection (DR/Traffic criteria), and
                managed outreach campaigns.
              </li>
              <li>
                <strong>Web Analytics & Reporting:</strong> Maintained and validated
                GA4 setups; designed interactive monthly client dashboards in Looker
                Studio with strategic roadmaps.
              </li>
            </ul>
          </div>

          <div class="job-card">
            <div class="job-header">
              <h3>
                Programmatic SEO Specialist <span class="company"
                  >@ Claryfi</span
                >
              </h3>
              <span class="job-date">Feb 2025 – Jun 2025</span>
            </div>
            <p class="job-sub">Varna • IT Services</p>
            <ul class="job-bullets">
              <li>
                <strong>Programmatic SEO & Bulk Page Generation:</strong> Built scalable
                systems for generating, formatting, and optimizing thousands of multilingual
                webpages.
              </li>
              <li>
                <strong>Meta Tag Automation:</strong> Automated creation of unique
                meta tags (titles, descriptions) at scale using AI tools, JSON, and
                Google Sheets.
              </li>
              <li>
                <strong>Data Extraction & Scripting:</strong> Utilized Node.js and
                Google Sheets automation to extract data, manage content, and populate
                page templates efficiently.
              </li>
              <li>
                <strong>Performance Monitoring:</strong> Tracked programmatic page
                performance using Google Search Console, Ahrefs, and SE Ranking.
              </li>
            </ul>
          </div>

          <div class="job-card">
            <div class="job-header">
              <h3>
                Webmaster & SEO Specialist <span class="company"
                  >@ Freelance</span
                >
              </h3>
              <span class="job-date">Aug 2023 – Dec 2024</span>
            </div>
            <p class="job-sub">Kyiv • IT & Web Development</p>
            <ul class="job-bullets">
              <li>
                Designed and developed customized websites for local businesses
                using HTML, CSS, and JavaScript.
              </li>
              <li>
                <strong>Technical Optimization:</strong> Identified duplicate content
                issues via Screaming Frog and wrote custom canonical/redirect rules;
                audited PageSpeed Insights and Schema microdata (Rich Results); optimized
                sitemaps and robots.txt.
              </li>
              <li>
                <strong>Semantics & Link Building:</strong> Built clustered semantic
                cores using Google Ads and Ahrefs; evaluated competitor link profiles
                and acquired quality backlinks.
              </li>
            </ul>
          </div>

          <div class="job-card">
            <div class="job-header">
              <h3>SEO Specialist <span class="company">@ Dila</span></h3>
              <span class="job-date">Jul 2023 – Aug 2023</span>
            </div>
            <p class="job-sub">Kyiv • Healthcare & Medical Services</p>
            <ul class="job-bullets">
              <li>
                Performed complete SEO audit for the primary medical platform
                (dila.ua).
              </li>
              <li>
                Identified duplicate URLs, implemented cleanup rules, validated
                microdata structure, and reviewed robots.txt and sitemaps.
              </li>
              <li>
                Built core keyword semantic trees and analyzed link acquisition
                opportunities against competitors.
              </li>
            </ul>
          </div>
        </section>

        <section class="main-block">
          <h2 class="section-title">// Education</h2>
          <!-- Google Ads Creative Certification -->
          <div class="edu-card">
            <div class="job-header">
              <h3>
                Google Ads Creative Certification <span class="company"
                  >@ Google Skillshop</span>
              </h3>
              <span class="job-date">Sep 2025</span>
            </div>
            <p class="job-sub">
              Validated expertise in designing high-performing ad creatives,
              leverage data-driven creative strategies across Search, Video, and
              Display campaigns, and executing creative A/B testing.
              <br />
              <a
                href="https://skillshop.credential.net/c1fca9a9-0b1d-49ba-9c4f-62859d647f54#acc.yA1QnMCR"
                target="_blank"
                rel="noopener noreferrer"
                style="color: var(--mako-cyan); font-family: monospace; font-size: 0.8rem; text-decoration: underline; display: inline-block; margin-top: 0.4rem;"
              >
                [Verify Credential ↗]
              </a>
            </p>
          </div>

          <div class="edu-card">
            <div class="job-header">
              <h3>
                SEO Certification <span class="company"
                  >@ Projector Creative & Tech</span
                >
              </h3>
              <span class="job-date">Jul 2023 – Aug 2023</span>
            </div>
            <p class="job-sub">
              Professional SEO Course: Technical SEO, Semantic Core, Content
              Creation, Link Building, SEO Analysis.
            </p>
          </div>

          <div class="edu-card">
            <div class="job-header">
              <h3>
                Full Stack Developer Certification <span class="company"
                  >@ GoIT IT School</span
                >
              </h3>
              <span class="job-date">Jan 2022 – Feb 2023</span>
            </div>
            <p class="job-sub">
              Full Stack Web Development: HTML5/CSS3, JavaScript, React,
              Node.js.
            </p>
          </div>

          <div class="edu-card">
            <div class="job-header">
              <h3>
                Bachelor’s Degree in Marketing <span class="company"
                  >@ DonNUET</span
                >
              </h3>
              <span class="job-date">Sep 2005 – Jul 2010</span>
            </div>
            <p class="job-sub">
              Focus areas: Marketing, Digital Marketing, Marketing Analysis,
              Economics, and Business Management.
            </p>
          </div>
        </section>
      </main>
    </div>
  </div>
</Layout>

<style>
  .resume-container {
    max-width: 1100px;
    margin: 0 auto;
    padding-top: 3rem; /* Уменьшили верхний отступ */
    padding-bottom: 5rem;
  }

  .action-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .code-badge {
    font-family: monospace;
    font-size: 0.85rem;
    color: var(--mako-cyan);
    letter-spacing: 1px;
  }

  .print-btn {
    font-family: monospace;
    background: transparent;
    border: 1px solid rgba(0, 240, 255, 0.4);
    color: var(--mako-cyan);
    padding: 0.6rem 1.2rem;
    border-radius: 4px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.85rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .print-btn:hover {
    background: rgba(0, 240, 255, 0.1);
    box-shadow: 0 0 15px rgba(0, 240, 255, 0.2);
    border-color: var(--mako-cyan);
  }

  /* Layout сетки */
  .resume-grid {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 2.5rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(0, 240, 255, 0.15);
    border-radius: 6px;
    padding: 2.5rem;
  }

  /* Sidebar */
  .resume-sidebar {
    border-right: 1px solid rgba(255, 255, 255, 0.08);
    padding-right: 2rem;
  }

  .photo-wrapper {
    width: 120px;
    height: 150px;
    border-radius: 6px;
    overflow: hidden;
    border: 2px solid var(--mako-cyan);
    margin-bottom: 1.25rem;
    }

  .profile-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .resume-name {
    font-size: 1.4rem;
    font-weight: 800;
    color: #fff;
    margin: 0 0 0.3rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .resume-title {
    font-size: 0.85rem;
    color: var(--mako-cyan);
    font-family: monospace;
    margin-bottom: 2rem;
    line-height: 1.3;
  }

  .side-block {
    margin-bottom: 2rem;
  }

  .side-block h3 {
    font-size: 0.85rem;
    font-family: monospace;
    color: #fff;
    text-transform: uppercase;
    border-bottom: 1px solid rgba(0, 240, 255, 0.3);
    padding-bottom: 0.4rem;
    margin-bottom: 1rem;
    letter-spacing: 1px;
  }

  .contact-list,
  .info-list {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.88rem;
    color: #cbd5e1; /* Повысили контрастность */
  }

  .contact-list li,
  .info-list li {
    margin-bottom: 0.75rem;
    line-height: 1.4;
  }

  .contact-list span {
    display: block;
    font-size: 0.75rem;
    color: #94a3b8; /* Подписи стали более читаемыми */
    text-transform: uppercase;
    font-family: monospace;
  }

  .contact-list a {
    color: var(--mako-cyan);
    text-decoration: none;
  }

  .skill-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .badge {
    font-family: monospace;
    font-size: 0.75rem;
    background: rgba(0, 240, 255, 0.05);
    border: 1px solid rgba(0, 240, 255, 0.25);
    color: #e2e8f0;
    padding: 0.25rem 0.55rem;
    border-radius: 3px;
  }

  /* Main Content */
  .resume-main {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .section-title {
    font-family: monospace;
    font-size: 1.1rem;
    color: var(--mako-cyan);
    margin: 0 0 1.25rem;
    letter-spacing: 1px;
  }

  .summary-text {
    color: #cbd5e1;
    line-height: 1.6;
    font-size: 0.95rem;
  }

  .job-card,
  .edu-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    padding: 1.25rem;
    border-radius: 4px;
    margin-bottom: 1.25rem;
  }

  .job-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.25rem;
  }

  .job-header h3 {
    font-size: 1.05rem;
    color: #fff;
    margin: 0;
  }

  .company {
    color: var(--mako-cyan);
  }

  .job-date {
    font-family: monospace;
    font-size: 0.8rem;
    color: #94a3b8; /* Исправили бледную дату */
  }

  .job-sub {
    font-size: 0.8rem;
    color: #8892b0;
    margin: 0 0 0.75rem;
    font-style: italic;
  }

  .job-bullets {
    margin: 0;
    padding-left: 1.2rem;
    color: #cbd5e1;
    font-size: 0.9rem;
  }

  .job-bullets li {
    margin-bottom: 0.4rem;
    line-height: 1.5;
  }

  /* Адаптивность для мобилок */
  @media (max-width: 850px) {
    .resume-grid {
      grid-template-columns: 1fr;
      padding: 1.5rem;
    }
    .resume-sidebar {
      border-right: none;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      padding-right: 0;
      padding-bottom: 2rem;
    }
  }
</style>
