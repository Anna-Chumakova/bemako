---
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/projects.js';
---

<Layout title="All Case Studies | Be Mako" description="Explore all technical SEO and AI promotion case studies.">
    <div class="page-content archive-container">
        
        <!-- Заголовок страницы архива -->
        <header class="archive-header">
            <span class="code-badge">// ARCHIVE</span>
            <h1 class="archive-title">All Case Studies</h1>
            <p class="archive-subtitle">
                A complete showcase of technical SEO optimizations, AI visibility engineering, and search architecture results.
            </p>
        </header>

        <!-- Сетка со ВСЕМИ карточками -->
        <div class="projects-grid">
            {projects.map((project) => (
                <a href={`/portfolio/${project.slug}`} class="project-card-link">
                    <div class="project-card">
                        <div class="card-badge">{project.badge}</div>
                        {project.image && (
                            <div class="card-image-wrapper">
                                <img src={project.image} alt={project.title} loading="lazy" />
                            </div>
                        )}
                        <h3>{project.title}</h3>
                        <p>{project.shortDesc}</p>
                        <div class="read-more">
                            Read Case Study 
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                        </div>
                    </div>
                </a>
            ))}
        </div>

    </div>
</Layout>

<style>
    .archive-container {
        padding-top: 6rem;
        padding-bottom: 5rem;
    }

    .archive-header {
        margin-bottom: 3.5rem;
    }

    .code-badge {
        font-family: monospace;
        font-size: 0.85rem;
        color: var(--mako-cyan);
        letter-spacing: 1px;
    }

    .archive-title {
        font-size: clamp(2rem, 4vw, 3rem);
        color: #fff;
        margin: 0.5rem 0 1rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .archive-subtitle {
        font-size: 1.05rem;
        color: #a0aec0;
        max-width: 650px;
        line-height: 1.6;
    }

    /* --- СЕТКА И КАРТОЧКИ (1 в 1 как в компоненте) --- */
    .projects-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 2rem;
        text-align: left;
    }

    .project-card-link {
        text-decoration: none;
        color: inherit;
        display: block;
    }

    .project-card {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.05);
        padding: 2.5rem 2rem;
        border-radius: 4px;
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        position: relative;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .card-badge {
        display: inline-block;
        font-family: monospace;
        font-size: 0.75rem;
        color: var(--mako-cyan);
        border: 1px solid rgba(0, 240, 255, 0.3);
        padding: 0.25rem 0.75rem;
        border-radius: 2px;
        margin-bottom: 1.5rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        width: fit-content;
    }

    .project-card-link:hover .project-card {
        transform: translateY(-5px);
        background: rgba(0, 240, 255, 0.01);
        border-color: rgba(0, 240, 255, 0.2);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
    }

    .card-image-wrapper {
        width: 100%;
        height: 180px;
        overflow: hidden;
        border-radius: 4px;
        border: 1px solid rgba(255, 255, 255, 0.05);
        margin-bottom: 1.5rem;
        position: relative;
    }

    .card-image-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .project-card-link:hover .card-image-wrapper img {
        transform: scale(1.04);
    }

    .project-card h3 {
        color: #fff;
        font-size: 1.25rem;
        margin: 0 0 1rem;
        line-height: 1.4;
    }

    .project-card p {
        font-size: 0.95rem;
        line-height: 1.6;
        margin: 0 0 1.5rem;
        color: var(--mako-text);
        flex-grow: 1;
    }

    .read-more {
        font-family: monospace;
        font-size: 0.85rem;
        color: var(--mako-cyan);
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: auto;
        transition: gap 0.2s ease;
    }

    .project-card-link:hover .read-more {
        gap: 0.8rem;
    }
</style>