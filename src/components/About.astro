---
import { Image } from 'astro:assets';
import profilePhoto from '../assets/my-photo2.jpg';

// 1. Динамический массив сертификатов и дипломов
const credentials = [
  {
    id: 'degree-marketing',
    title: "Bachelor's Degree in Marketing",
    issuer: 'University',
    year: '2018',
    type: 'Degree',
    description: 'Specialization in strategic marketing, market analysis, consumer behavior, and brand management.',
    image: '/certificates/marketing-degree.jpg'
  },
  {
    id: 'seo-cert-1',
    title: 'Advanced Technical SEO Certification',
    issuer: 'SEO Academy',
    year: '2023',
    type: 'Certification',
    description: 'In-depth specialization in site architecture, Core Web Vitals optimization, crawling budget allocation, and indexing strategies.',
    image: '/certificates/seo-cert-1.jpg'
  },
  {
    id: 'seo-cert-2',
    title: 'Programmatic SEO & Data Automation',
    issuer: 'Tech Institute',
    year: '2024',
    type: 'Certification',
    description: 'Building automated page generation pipelines, custom script development with Node.js, and structured schema integration.',
    image: '/certificates/seo-cert-2.jpg'
  }
];

// Автоматически формируем микроразметку для schema.org
const jsonLdCredentials = credentials.map(c => ({
  "@type": "EducationalOccupationalCredential",
  "name": c.title,
  "credentialCategory": c.type,
  "recognizedBy": {
    "@type": "Organization",
    "name": c.issuer
  }
}));
---

<!-- JSON-LD Схема для поисковых роботов с сертификатами и соцсетями -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Аня",
  "alternateName": "Anya SEO",
  "jobTitle": "Data-Driven Technical SEO Engineer",
  "worksFor": {
    "@type": "Organization",
    "name": "Be Mako Studio",
    "url": "https://be-mako.com"
  },
  "description": "Технический SEO-инженер и основатель студии Be Mako.",
  "url": "https://be-mako.com",
  "knowsAbout": [
    "Technical SEO",
    "Search Engine Optimization",
    "Astro Framework",
    "Node.js Automation",
    "AI Engineering",
    "Programmatic SEO"
  ],
  "hasCredential": jsonLdCredentials,
  "sameAs": [
    "https://github.com/your-github",
    "https://linkedin.com/in/your-linkedin",
    "https://t.me/your-telegram"
  ]
})} />

<section id="about" class="page-content about-section">
    <div class="code-accent">// WHO I AM</div>
    <div class="about-grid">
        
        <!-- Текстовая колонка -->
        <div class="about-content">
            <h2>Data-Driven Technical SEO Engineer</h2>
            <p>
                Hi, I'm Anya. I bridge the gap between heavy automation, clean code architectures, and aggressive organic growth. 
                While traditional SEOs rely only on third-party platforms, I build custom automated pipelines using <strong>Node.js</strong> and <strong>AI</strong> models like Gemini to capture scale that others cannot reach.
            </p>
            <p>
                Whether it’s executing a zero-traffic-loss enterprise migration to modern frameworks like <strong>Astro</strong> or launching global programmatic SEO infrastructure from scratch, my goal is simple: engineering maximum search visibility at peak technical performance.
            </p>
        </div>

        <!-- Колонка с фото -->
        <div class="about-image-wrapper">
            <div class="image-frame">
                <Image 
                    src={profilePhoto} 
                    alt="Anya — Technical SEO Engineer and Founder of Be Mako Studio" 
                    width={380}
                    height={380}
                    loading="eager" 
                    class="profile-img"
                />
            </div>
        </div>

        <!-- Блок с сертификатами (Вынесен под текст и фото) -->
        <div class="credentials-block">
            <h3 class="credentials-title">// EDUCATION & CERTIFICATIONS</h3>
            
            <div class="accordion-list">
                {credentials.map((item) => (
                    <details class="cred-item">
                        <summary class="cred-summary">
                            <div class="cred-header-text">
                                <span class="cred-name">{item.title}</span>
                                <span class="cred-meta">{item.issuer} • {item.year}</span>
                            </div>
                            <span class="accordion-icon">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                    <path d="M6 9l6 6 6-6"/>
                                </svg>
                            </span>
                        </summary>
                        
                        <div class="cred-body">
                            <p class="cred-desc">{item.description}</p>
                            {item.image && (
                                <div class="cred-image-wrapper">
                                    <img src={item.image} alt={`${item.title} - ${item.issuer}`} loading="lazy" />
                                </div>
                            )}
                        </div>
                    </details>
                ))}
            </div>
        </div>

    </div>
</section>

<style>
    .about-section {
        padding: var(--section-gap) 0 2rem;
    }

    .about-grid {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 3rem;
        align-items: start;
    }

    .code-accent {
        font-family: monospace;
        color: var(--mako-cyan);
        letter-spacing: 2px;
        font-size: 0.85rem;
        margin-bottom: 1rem;
    }

    h2 {
        font-size: clamp(1.75rem, 4vw, 2.5rem);
        color: #fff;
        margin: 0 0 1.5rem;
        font-weight: 800;
    }

    p {
        font-size: clamp(0.95rem, 1.5vw, 1.05rem);
        line-height: 1.7;
        color: var(--mako-text);
        margin-bottom: 1.5rem;
    }

    strong {
        color: #fff;
        font-weight: 600;
    }

    /* --- СТИЛИ ДЛЯ ВЫПАДАЮЩИХ СЕРТИФИКАТОВ --- */
    .credentials-block {
        grid-column: 1 / -1; /* Занимает всю ширину грида */
        margin-top: 1.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .credentials-title {
        font-family: monospace;
        font-size: 0.85rem;
        color: var(--mako-cyan);
        letter-spacing: 1.5px;
        margin-bottom: 1.2rem;
    }

    /* Сетка сертификатов на Flexbox */
    .accordion-list {
        display: flex;
        flex-wrap: wrap;
        gap: 1.25rem;
        align-items: flex-start;
    }

    .cred-item {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-left: 3px solid transparent;
        border-radius: 4px;
        overflow: hidden;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        
        /* По умолчанию на мобилках — 100% ширины */
        flex: 1 1 100%;
        box-sizing: border-box;
    }

    .cred-item:hover {
        border-color: rgba(0, 240, 255, 0.2);
        border-left-color: var(--mako-cyan);
        background: rgba(0, 240, 255, 0.02);
        transform: translateY(-2px);
    }

    .cred-item[open] {
        border-color: rgba(0, 240, 255, 0.3);
        border-left-color: var(--mako-cyan);
        background: rgba(0, 240, 255, 0.03);
    }

    .cred-summary {
        padding: 1.1rem 1.25rem;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        list-style: none;
        user-select: none;
    }

    .cred-summary::-webkit-details-marker {
        display: none;
    }

    .cred-header-text {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .cred-name {
        color: #fff;
        font-weight: 600;
        font-size: 0.95rem;
        transition: color 0.2s ease;
    }

    .cred-item:hover .cred-name {
        color: var(--mako-cyan);
    }

    .cred-meta {
        font-family: monospace;
        font-size: 0.75rem;
        color: #8a99a8;
    }

    .accordion-icon {
        color: var(--mako-cyan);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.3s ease;
    }

    .cred-item[open] .accordion-icon {
        transform: rotate(180deg);
    }

    .cred-body {
        padding: 0 1.25rem 1.25rem 1.25rem;
        border-top: 1px dashed rgba(255, 255, 255, 0.05);
        margin-top: 0.5rem;
    }

    .cred-desc {
        font-size: 0.88rem;
        line-height: 1.5;
        color: #a0aec0;
        margin: 0.75rem 0 1rem;
    }

    .cred-image-wrapper {
        width: 100%;
        max-width: 100%;
        border-radius: 4px;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.1);
        background: #000;
    }

    .cred-image-wrapper img {
        width: 100%;
        height: auto;
        display: block;
        object-fit: contain;
    }

    /* --- ФОТО И ИЗОБРАЖЕНИЯ --- */
    .about-image-wrapper {
        display: flex;
        justify-content: center;
        width: 100%;
    }
    
    .image-frame {
        position: relative;
        border: 1px solid rgba(0, 240, 255, 0.2);
        padding: 10px;
        background: rgba(255, 255, 255, 0.01);
        border-radius: 4px;
        width: 100%;
        max-width: 400px;
        aspect-ratio: 1 / 1;
        box-sizing: border-box;
    }
    
    .image-frame::before {
        content: '';
        position: absolute;
        top: -1px;
        left: -1px;
        width: 20px;
        height: 20px;
        border-top: 2px solid var(--mako-cyan);
        border-left: 2px solid var(--mako-cyan);
    }
    
    .profile-img {
        display: block;
        width: 100%;
        height: 100%;
        max-width: 380px;
        aspect-ratio: 1 / 1;
        object-fit: cover;
        border-radius: 2px;
        filter: grayscale(20%) contrast(110%);
        transition: filter 0.3s ease;
    }
    
    .image-frame:hover .profile-img {
        filter: grayscale(0%) contrast(100%);
    }

    /* --- МОБИЛЬНАЯ ВЕРСИЯ (до 992px) --- */
    @media (max-width: 992px) {
        .about-grid {
            grid-template-columns: 1fr;
            gap: 2rem;
        }

        .about-image-wrapper {
            order: 1; /* Фото первое сверху */
        }

        .about-content {
            order: 2; /* Текст второй */
        }

        .credentials-block {
            order: 3; /* Сертификаты строго третьи по порядку */
            margin-top: 1rem;
        }
    }

    /* --- ДЕСКТОП ВЕРСИЯ (от 1024px) --- */
    @media (min-width: 1024px) {
        .cred-item {
            /* 3 в ряд на десктопе с авто-растяжением через Flexbox */
            flex: 1 1 calc(33.333% - 1.25rem);
            min-width: 280px;
        }
    }
</style>