---
// 1. Получение данных из Google Places API
const placeId = import.meta.env.PUBLIC_GOOGLE_PLACE_ID;
const apiKey = import.meta.env.GOOGLE_PLACES_API_KEY;

interface Review {
  author_name: string;
  profile_photo_url: string;
  rating: number;
  relative_time_description: string;
  text: string;
  author_url?: string;
}

let reviews: Review[] = [];
let overallRating = 5.0;
let totalReviews = 0;

// Если ключи заданы, подтягиваем реальные отзывы с Google
if (placeId && apiKey) {
  try {
    const response = await fetch(
      `https://maps.googleapis.com/maps/api/place/details/json?place_id=${placeId}&fields=reviews,rating,user_ratings_total&key=${apiKey}&language=en`
    );
    const data = await response.json();
    if (data.result) {
      reviews = data.result.reviews || [];
      overallRating = data.result.rating || 5.0;
      totalReviews = data.result.user_ratings_total || reviews.length;
    }
  } catch (e) {
    console.error("Ошибка загрузки Google Reviews:", e);
  }
}

// Запасные демо-данные (пока карта регистрируется)
if (reviews.length === 0) {
  reviews = [
    {
      author_name: "Alex Rivera",
      profile_photo_url: "https://lh3.googleusercontent.com/a/default-user=s128-c",
      rating: 5,
      relative_time_description: "a month ago",
      text: "Anya helped us fix massive indexing issues and restructured our Astro architecture. Organic traffic grew by 140% in just 3 months. Outstanding technical SEO depth!",
    },
    {
      author_name: "Elena Rostova",
      profile_photo_url: "https://lh3.googleusercontent.com/a/default-user=s128-c",
      rating: 5,
      relative_time_description: "2 months ago",
      text: "The programmatic SEO pipeline built for our platform scaled our landing pages effortlessly without losing site speed. Highly recommend Be Mako!",
    }
  ];
  totalReviews = 2;
}

const googleMapsReviewUrl = placeId 
  ? `https://search.google.com/local/writereview?placeid=${placeId}`
  : "https://maps.google.com";
---

<section class="reviews-section page-content">
  <div class="reviews-header">
    <div class="header-titles">
      <div class="code-accent">// CLIENT FEEDBACK</div>
      <h2>Verified Google Reviews</h2>
    </div>

    <!-- Общий рейтинг Google -->
    <div class="google-rating-badge">
      <div class="google-logo">
        <svg width="24" height="24" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
        </svg>
      </div>
      <div class="rating-info">
        <div class="rating-score">
          <span class="score-num">{overallRating.toFixed(1)}</span>
          <div class="stars">★★★★★</div>
        </div>
        <span class="reviews-count">Based on {totalReviews} Google reviews</span>
      </div>
    </div>
  </div>

  <!-- Список отзывов -->
  <div class="reviews-grid">
    {reviews.map((rev) => (
      <div class="review-card">
        <div class="card-header">
          <img src={rev.profile_photo_url} alt={rev.author_name} class="author-avatar" loading="lazy" />
          <div class="author-details">
            <span class="author-name">{rev.author_name}</span>
            <span class="review-date">{rev.relative_time_description}</span>
          </div>
          <!-- Значок проверки Google -->
          <div class="google-icon-small" title="Posted on Google">
            <svg width="16" height="16" viewBox="0 0 24 24">
              <path fill="#8a99a8" d="M12.545,10.239v3.821h5.445c-0.712,2.315-2.647,3.972-5.445,3.972c-3.332,0-6.033-2.701-6.033-6.032s2.701-6.032,6.033-6.032c1.498,0,2.866,0.549,3.921,1.453l2.814-2.814C17.503,2.988,15.139,2,12.545,2C7.021,2,2.543,6.477,2.543,12s4.478,10,10.002,10c8.396,0,10.249-7.85,9.426-11.761H12.545z"/>
            </svg>
          </div>
        </div>

        <div class="card-stars">
          {'★'.repeat(rev.rating)}
        </div>

        <p class="review-text">{rev.text}</p>
      </div>
    ))}
  </div>

  <!-- Кнопка призыва оставить отзыв -->
  <div class="reviews-cta">
    <a href={googleMapsReviewUrl} target="_blank" rel="noopener noreferrer" class="google-btn">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/>
      </svg>
      Review us on Google
    </a>
  </div>
</section>

<style>
  .reviews-section {
    padding: 3rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .reviews-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .code-accent {
    font-family: monospace;
    color: var(--mako-cyan, #00f0ff);
    font-size: 0.85rem;
    letter-spacing: 2px;
    margin-bottom: 0.5rem;
  }

  h2 {
    font-size: clamp(1.75rem, 3vw, 2.2rem);
    color: #fff;
    margin: 0;
    font-weight: 800;
  }

  /* Бэдж рейтинга Google */
  .google-rating-badge {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.75rem 1.25rem;
    border-radius: 6px;
  }

  .rating-score {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .score-num {
    color: #fff;
    font-weight: 700;
    font-size: 1.1rem;
  }

  .stars {
    color: #FBBC05; /* Фирменный жёлтый цвет звезд Google */
    font-size: 0.95rem;
    letter-spacing: 2px;
  }

  .reviews-count {
    display: block;
    font-size: 0.75rem;
    color: #8a99a8;
    font-family: monospace;
  }

  /* Грид отзывов */
  .reviews-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .review-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 6px;
    padding: 1.5rem;
    flex: 1 1 calc(50% - 1.25rem);
    min-width: 290px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: border-color 0.3s ease, transform 0.3s ease;
  }

  .review-card:hover {
    border-color: rgba(0, 240, 255, 0.25);
    transform: translateY(-3px);
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 0.75rem;
  }

  .author-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
  }

  .author-details {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .author-name {
    color: #fff;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .review-date {
    font-size: 0.75rem;
    color: #8a99a8;
  }

  .card-stars {
    color: #FBBC05;
    font-size: 0.85rem;
    margin-bottom: 0.75rem;
    letter-spacing: 1px;
  }

  .review-text {
    font-size: 0.9rem;
    line-height: 1.6;
    color: #a0aec0;
    margin: 0;
  }

  /* CTA */
  .reviews-cta {
    margin-top: 2rem;
    display: flex;
    justify-content: center;
  }

  .google-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #fff;
    padding: 0.75rem 1.5rem;
    border-radius: 4px;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .google-btn:hover {
    border-color: var(--mako-cyan, #00f0ff);
    color: var(--mako-cyan, #00f0ff);
    background: rgba(0, 240, 255, 0.03);
  }

  @media (max-width: 768px) {
    .review-card {
      flex: 1 1 100%;
    }
  }
</style>