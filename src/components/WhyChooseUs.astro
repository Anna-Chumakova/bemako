---
import { Image } from 'astro:assets';
import myPhoto from '../assets/my-photo2.jpg';

const leftFeatures = [
  {
    icon: `<svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>`,
    title: "Technical Expertise",
    desc: "In-depth code-level SEO audits, crawl budget optimization, and site architecture built for maximum indexability."
  },
  {
    icon: `<svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>`,
    title: "99% Success Rate",
    desc: "Data-backed traffic recovery, clean SEO migrations without losing rankings, and transparent analytics tracking."
  },
  {
    icon: `<svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>`,
    title: "CWV & Performance",
    desc: "Obsessed with 100/100 Core Web Vitals, lightning-fast rendering, and flawless mobile user experience."
  }
];

const rightFeatures = [
  {
    icon: `<svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 1 0 10 10H12V2z"></path><path d="M12 2a10 10 0 0 1 10 10h-10V2z"></path></svg>`,
    title: "AI & GEO Ready",
    desc: "Optimizing content and site structure specifically for ChatGPT, Perplexity, Gemini, and Google AI Overviews."
  },
  {
    icon: `<svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>`,
    title: "Direct Specialist Access",
    desc: "No middleman agency managers. You work directly with a Senior Technical SEO & Engineering strategist."
  },
  {
    icon: `<svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>`,
    title: "Sustainable ROI",
    desc: "Focusing on qualified search intent, scalable organic growth, and conversion-driven landing pages."
  }
];
---

<section class="why-us-section">
  <div class="why-us-header">
    <span class="code-accent">// ADVANTAGES</span>
    <h2 class="section-title">Why Choose Be Mako</h2>
  </div>

  <div class="why-us-grid">
    <!-- Левая колонка со свойствами -->
    <div class="features-col">
      {leftFeatures.map(item => (
        <div class="feature-item">
          <div class="icon-box" set:html={item.icon} />
          <div class="feature-content">
            <h3 class="feature-title">{item.title}</h3>
            <p class="feature-desc">{item.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Центральная Glassmorphism карточка с фото -->
    <div class="center-card">
      <div class="card-image-wrapper">
        <Image 
          src="/anna.webp"
          alt="Anna Chumakova - Senior Technical SEO Specialist" 
          width={400}
          height={300}
          loading="lazy"
          decoding="async"
          class="profil-photo"
        />
      </div>
      <div class="card-info">
        <p class="card-text">
          Ready to turn search visibility into predictable revenue? Let's engineer your growth strategy.
        </p>
        <a href="#contact" class="mako-btn mako-btn-sm">
          <span>Work With Me <span class="arrow">→</span></span>
        </a>
      </div>
    </div>

    <!-- Правая колонка со свойствами -->
    <div class="features-col">
      {rightFeatures.map(item => (
        <div class="feature-item">
          <div class="icon-box" set:html={item.icon} />
          <div class="feature-content">
            <h3 class="feature-title">{item.title}</h3>
            <p class="feature-desc">{item.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .why-us-section {
    padding: var(--section-gap, 4rem) 0;
  }

  .why-us-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .code-accent {
    font-family: var(--font-code, monospace);
    color: var(--mako-cyan, #00f0ff);
    font-size: 0.85rem;
    letter-spacing: 1px;
  }

  .section-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    color: #fff;
    margin: 0.5rem 0 0;
    font-weight: 800;
  }

  .why-us-grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr 1fr;
    gap: 2rem;
    align-items: center;
  }

  /* Колонки с фичами */
  .features-col {
    display: flex;
    flex-direction: column;
    gap: 2.2rem;
  }

  .feature-item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.8rem;
  }

  .icon-box {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(0, 240, 255, 0.08);
    border: 1px solid rgba(0, 240, 255, 0.3);
    color: var(--mako-cyan, #00f0ff);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 15px rgba(0, 240, 255, 0.1);
    transition: all 0.3s ease;
  }

  .feature-item:hover .icon-box {
    background: var(--mako-cyan, #00f0ff);
    color: #0b1117;
    box-shadow: 0 0 20px rgba(0, 240, 255, 0.4);
    transform: scale(1.05);
  }

  .feature-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #fff;
    margin: 0 0 0.4rem 0;
  }

  .feature-desc {
    font-size: 0.88rem;
    line-height: 1.6;
    color: #8a99a8;
    margin: 0;
  }

  /* --- Центральная Glassmorphism карточка --- */
  .center-card {
    background: rgba(255, 255, 255, 0.02);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 10px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    border-color: rgba(0, 240, 255, 0.3);
    box-shadow: 0 20px 40px -10px rgba(0, 240, 255, 0.15);
    transition: all 0.3s ease;
  }

  .card-image-wrapper {
    max-width: 100%;
    border-radius: 12px;
    overflow: hidden;
    background: #05080a;
  }

  .card-image-wrapper img {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .center-card:hover .card-image-wrapper img {
    transform: scale(1.02);
  }

  .profil-photo {
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 85%, transparent 100%),
                        linear-gradient(to right, transparent 0%, black 30%, black 70%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 85%, transparent 100%),
                linear-gradient(to right, transparent 0%, black 30%, black 70%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }

  .card-info {
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: 1.5rem 1.25rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .card-text {
    font-size: 0.9rem;
    line-height: 1.6;
    color: #cbd5e1;
    margin: 0;
  }

  /* Адаптивность */
  @media (max-width: 992px) {
    .why-us-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .center-card {
      order: -1;
      max-width: 450px;
      margin: 0 auto;
      width: 100%;
    }

    .features-col {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 2rem;
    }
  }
</style>